# PostgreSQL 连接串：API、worker 和 Alembic 迁移都会使用。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25432/novel_localize
# 服务鉴权 token：调用 /models、/prompt-templates、/jobs 等受保护 API 时放到 Authorization: Bearer。
SERVICE_API_KEY=dev-service-key

# Redis 连接串：Celery broker / result backend 使用。
REDIS_URL=redis://127.0.0.1:26379/0
# CORS 允许来源：本地前端调 API 时使用；多个来源用逗号分隔。
ALLOWED_ORIGINS=http://localhost:3000
# 对象存储后端：local 写入本机目录；aliyun_oss 读写阿里云 OSS。
STORAGE_BACKEND=local
# local 对象存储目录：仅 STORAGE_BACKEND=local 时生效。
LOCAL_OBJECT_STORAGE_PATH=storage/objects

# 阿里云 OSS bucket 名称：STORAGE_BACKEND=aliyun_oss 时必填。
OSS_BUCKET=
# 阿里云 OSS region，例如 cn-shenzhen。
OSS_REGION=
# 阿里云 OSS AccessKey ID：真实值只写本地 .env，不要提交。
OSS_ACCESS_KEY_ID=
# 阿里云 OSS AccessKey Secret：真实值只写本地 .env，不要提交。
OSS_ACCESS_KEY_SECRET=
# OSS 项目根目录前缀：服务读写对象时会自动拼到 oss_key 前面。
OSS_PROJECT_ROOT=
# Job 输出对象默认前缀：服务生成 localized.txt / translated.txt 等产物时使用。
OSS_OUTPUT_PREFIX=novel-localization/jobs
# 产物对外访问域名：用于生成 oss_url；为空时使用 OSS_ENDPOINT 推导。
OSS_PUBLIC_ENDPOINT=
# OSS API endpoint：为空时按 OSS_REGION 推导为 oss-${OSS_REGION}.aliyuncs.com。
OSS_ENDPOINT=
# endpoint 风格：virtual_host / custom_domain / path；为空时自动推导。
OSS_ENDPOINT_STYLE=
# OSS URL 协议：通常为 https。
OSS_SCHEME=https

# Callback 签名密钥：服务回调业务后端时生成 X-AI-Service-Signature。
CALLBACK_SIGNING_SECRET=dev-callback-secret
# 是否允许 http://127.0.0.1 或 http://localhost callback；本地联调可为 true，非本地环境应关闭。
ALLOW_INSECURE_CALLBACKS=true
# Callback 单次 HTTP 请求超时，单位秒。
CALLBACK_TIMEOUT_SECONDS=5

# OpenAI API Key：真实模型调用必填；不要提交真实密钥。
OPENAI_API_KEY=
# OpenAI 兼容网关地址：为空表示使用默认 OpenAI endpoint；私有网关/代理时填写。
OPENAI_BASE_URL=
# 默认模型 ID：必须出现在 GET /models 返回的 enabled 模型中。
DEFAULT_MODEL_ID=gpt-4.1
# ── AI 调用超时链（三个变量必须满足：MODEL_CALL_TIMEOUT_SECONDS < CELERY_SOFT_TIME_LIMIT < CELERY_TIME_LIMIT）──
#
# L1  MODEL_CALL_TIMEOUT_SECONDS：asyncio.wait_for 硬截断 AI 调用，超时后 job → failed(JOB_TIMEOUT) + 发 Callback。
#     这是调用方感知到的有效超时。httpx read_timeout 对 chunked LLM 响应无效，必须依赖此层。
#     同时传给 litellm.acompletion(timeout=) 作为泄漏线程的退出上限。
#     调整场景：输入文本短（< 5000字）可设 300；小说章节（< 20000字）建议 600；超长文本可调到 1200。
#
# L2  CELERY_SOFT_TIME_LIMIT：L1 未能截断时（极端情况）的进程级兜底。SIGALRM 信号中断整个 worker 进程。
#     建议比 MODEL_CALL_TIMEOUT_SECONDS 大 ≥ 300s，留足 job 状态写入和 Callback 发送的时间。
#
# L3  CELERY_TIME_LIMIT：L2 处理超时后的强杀兜底。建议比 CELERY_SOFT_TIME_LIMIT 大 60s。
#
MODEL_CALL_TIMEOUT_SECONDS=600
CELERY_SOFT_TIME_LIMIT=1800
CELERY_TIME_LIMIT=1860
# ─────────────────────────────────────────────────────────────────────────────────────────────────
# 单次模型 API 调用失败后的 SDK 重试次数；默认 0，避免重复产生模型费用。
MODEL_CALL_MAX_RETRIES=0
# Prompt 配置文件：定义各 job_type 的 system/user/work_note 默认值和运行时输出契约。
PROMPT_CONFIG_PATH=app/infrastructure/novel_loc/prompts.yaml

# OSS 输入最大字节数；超过后 Job failed，error.code=INPUT_TOO_LARGE。
OSS_INPUT_MAX_BYTES=5242880
# Job 排队超时，单位秒；当前仅作为配置项保留，代码中暂未使用（由 JOB_STALE_RUNNING_SECONDS 兜底）。
JOB_QUEUE_TIMEOUT_SECONDS=600
# Job 整体执行超时，单位秒；当前仅作为配置项保留，代码中暂未使用（由 CELERY_SOFT_TIME_LIMIT 兜底）。
JOB_EXECUTION_TIMEOUT_SECONDS=1800
# Celery 任务最大重试次数；默认 0，不自动重试失败 Job。
CELERY_MAX_RETRIES=0
# Celery 重试间隔，单位秒；仅 CELERY_MAX_RETRIES > 0 时有意义。
CELERY_RETRY_DELAY=60
# Celery result backend 结果保留时间，单位秒。
CELERY_RESULT_EXPIRES=86400

# 是否启用分块并行执行（chunked 模式）；false 时所有任务强制走 single 整体执行。
NOVEL_LOCALIZATION_CHUNKING_ENABLED=false
# single 模式阈值：去空白后的字符数不超过该值时走整体执行；超过且 CHUNKING_ENABLED=true 时走分块。
NOVEL_LOCALIZATION_SINGLE_MAX_CHARS=20000
# 分块目标大小：按段落/句子聚合切分时单块的目标字符数。
NOVEL_LOCALIZATION_CHUNK_SIZE=3000

# 日志级别：常用值为 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# Worker 启动参数（由 start-worker.sh 读取，不影响 API 服务）
# Pool 模式：solo = 单任务串行（默认）；threads = 多线程并发。
WORKER_POOL=solo
# 并发线程数：仅 WORKER_POOL=threads 时生效；建议与期望同时运行的 Job 数一致。
# WORKER_CONCURRENCY=4
# Worker 日志级别：debug / info / warning / error。
# WORKER_LOGLEVEL=info
