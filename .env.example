# ══════════════════════════════════════════════════════════════════════════════
# fastapi-best-ai-architecture 配置模板
#
# 配置面设计原则：只暴露业务可理解的控制意图变量；派生值由代码自动计算；
# 启动时强制校验约束。所有内部缓冲区、批大小、Taskiq 内部参数均为代码默认值，
# 不在通用 env 模板暴露；确需新增运维旋钮时，应先补充代码校验、模板和文档。
# ══════════════════════════════════════════════════════════════════════════════

# ── 服务身份 ──────────────────────────────────────────────────────────────────
# 运行环境身份：local/dev 为开发模式；test/prd 为发布模式，启用同一套生产级启动校验。
APP_ENV=local
# 模板默认名；复用本模板时优先替换该值，并同步 SERVICE_NAME / SERVICE_TITLE / POSTGRES_DB。
TEMPLATE_NAME=fastapi-best-ai-architecture
SERVICE_NAME=fastapi-best-ai-architecture
SERVICE_TITLE=FastAPI Best AI Architecture
SERVICE_API_PREFIX=/api/v1/ai-jobs

# ── 基础设施凭证 ──────────────────────────────────────────────────────────────
# PostgreSQL 连接串：API、worker 和 Alembic 迁移都会使用。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25432/fastapi_best_ai_architecture
# 本地 docker compose 不需要 SSL；生产环境改为 true 或移除此行（默认 true）。
DB_SSL=false
# DB 连接池容量（API pod 维度）：
#   api_pod 数 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + worker_pod 数 × WORKER_CONCURRENCY ≤ PG max_connections(100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 服务鉴权 token：调用 /models、/prompt-templates、/jobs 等受保护 API 时放到 Authorization: Bearer。
SERVICE_API_KEY=<替换为随机 token>
# 本地联调开关：true 时跳过 Authorization: Bearer 校验；仅允许 loopback API/DB/Redis 地址，生产环境必须保持 false。
DISABLE_HTTP_AUTH_HEADER=false
# 本地联调开关：true 时忽略 X-AI-Service-Caller-ID，并统一使用 default caller_id；仅允许 loopback API/DB/Redis 地址，生产环境必须保持 false。
DISABLE_CALLER_ID_HEADER=false

# Redis 连接串：Taskiq broker 使用。
REDIS_URL=redis://127.0.0.1:26379/0
# TaskIQ broker 行为；默认使用支持 ACK 的 Redis Stream，redis_list 仅用于显式本地便利模式。
TASKIQ_BROKER_KIND=redis_stream

# ── API 访问控制 ──────────────────────────────────────────────────────────────
# CORS 允许来源；多个来源用逗号分隔。
ALLOWED_ORIGINS=http://localhost:3000
# Callback 签名密钥：服务回调业务后端时生成 X-AI-Service-Signature。
CALLBACK_SIGNING_SECRET=<替换为随机 32 字节 hex>
# 是否允许 http://127.0.0.1 或 http://localhost callback；本地联调可为 true，非本地环境应关闭。
ALLOW_INSECURE_CALLBACKS=true

# ── 对象存储（可选）────────────────────────────────────────────────────────────
# 当前接口服务默认不需要对象存储配置；仅在后续启用对象存储输入/输出时按需打开。
# local 只适用于本地开发或单机 compose；生产/多副本 API + worker 必须使用外部对象存储后端。
STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_PATH=storage/objects
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PROJECT_ROOT=
OSS_OUTPUT_PREFIX=ai-jobs
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=

# ── AI 执行 ───────────────────────────────────────────────────────────────────
# OpenAI API Key：真实模型调用必填；不要提交真实密钥。
OPENAI_API_KEY=
# OpenAI 兼容网关地址：为空表示使用默认 OpenAI endpoint；私有网关/代理时填写。
OPENAI_BASE_URL=
# 默认模型 ID：必须出现在 GET /models 返回的 enabled 模型中。
DEFAULT_MODEL_ID=gpt-5.5
# poster_title_image 风格探针模型：内部多模态文本分析使用；当前也作为 OpenAI Responses 生图调用宿主模型。
POSTER_TITLE_IMAGE_STYLE_PROBE_MODEL_ID=gpt-5.5
# poster_title_image 默认生图模型：调用方不传 items[].model_id 时使用。
POSTER_TITLE_IMAGE_GENERATION_DEFAULT_MODEL_ID=gpt-image-2
# poster_title_image 允许调用方选择的生图模型列表；首版仅支持 gpt-image-2。
POSTER_TITLE_IMAGE_GENERATION_ALLOWED_MODEL_IDS=gpt-image-2
# poster_title_image 单 Job item 数量上限；默认允许批量提交最多 50 个 item。
POSTER_TITLE_IMAGE_MAX_ITEMS=50
# poster_title_image 单 item 候选图数量上限；只能在接口硬上限 1..4 内收紧，不能放大。
POSTER_TITLE_IMAGE_MAX_DRAW_COUNT=4
# poster_title_image 参考图 OSS 来源白名单；多个值用逗号分隔。生产环境应配置为 CPP 约定的输入 bucket/region。
POSTER_TITLE_IMAGE_ALLOWED_OSS_BUCKETS=local-dev
POSTER_TITLE_IMAGE_ALLOWED_OSS_REGIONS=local
# 模型配置 YAML：定义 /models 返回列表、LiteLLM model id、上下文窗口和调用参数。
MODEL_CONFIG_PATH=app/core/models.yaml
# 价格配置 YAML：enabled 模型必须能通过 pricing_ref 找到合法成本估算规则。
PRICING_CONFIG_PATH=app/core/pricing.yaml
# 公共 billing 查询开关；关闭后真实 LLM 调用仍必须经 AI gateway 落账。
BILLING_ENABLED=true
# 是否在模型目录公开 billing capability 摘要；首版默认不扩大 /models 响应。
MODEL_CATALOG_EXPOSE_BILLING_CAPABILITY=false
# AI 调用超时（L1 锚点）：asyncio.wait_for 硬截断 AI 调用；超时后 job → failed(JOB_TIMEOUT) + 发 Callback。
# 代码自动派生 worker 超时链和 recovery 扫描阈值，无需手动配置。
# 调整参考：短文本（< 5000 字）可设 300；中长文本（< 20000 字）建议 600；超长文本可调到 1200。
MODEL_CALL_TIMEOUT_SECONDS=600

# ── Job 容量 & 吞吐量 ─────────────────────────────────────────────────────────
# queued+running 总积压上限，超出返回 503；0 = 禁用检查（内部系统或有外部限速时使用）。
MAX_ACTIVE_JOBS=5000
# 对象存储输入最大字节数；仅启用对象存储输入时需要。
OSS_INPUT_MAX_BYTES=5242880

# ── Callback 可靠性 ───────────────────────────────────────────────────────────
# Callback 单次 HTTP 请求超时，单位秒。
CALLBACK_TIMEOUT_SECONDS=5
# Callback 最大投递尝试次数；终态后立即尝试 1 次，失败后由 recovery 补偿。
CALLBACK_MAX_DELIVERY_ATTEMPTS=12
# Callback 补偿重试间隔，单位秒。
# 约束：必须大于代码派生的内部领取窗口；违反时启动报错。
CALLBACK_RETRY_DELAY_SECONDS=300

# ── Job 恢复策略 ─────────────────────────────────────────────────────────────
# dispatch outbox publish lease / published orphan 超过此秒未推进时，recovery 重新投递同一 attempt_id。
JOB_ORPHAN_TIMEOUT_SECONDS=300
# dispatch outbox publish 最大尝试次数，耗尽后进入应用级 dead_letter。
JOB_DISPATCH_MAX_PUBLISH_ATTEMPTS=12

# ── Prompt 配置 ──────────────────────────────────────────────────────────────
PROMPT_CONFIG_PATH=app/core/prompts.yaml

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
