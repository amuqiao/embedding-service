# ══════════════════════════════════════════════════════════════════════════════
# embedding-service 配置模板
#
# 配置面设计原则：只暴露业务可理解的控制意图变量；派生值由代码自动计算；
# 启动时强制校验约束。所有内部缓冲区、批大小、Taskiq 内部参数均为代码默认值，
# 不在通用 env 模板暴露；确需新增运维旋钮时，应先补充代码校验、模板和文档。
# ══════════════════════════════════════════════════════════════════════════════

# ── 服务身份 ──────────────────────────────────────────────────────────────────
# 运行环境身份：local/dev 为开发模式；test/prd 为发布模式，启用同一套生产级启动校验。
APP_ENV=local
# 服务默认名；复用本模板时优先替换该值，并同步 SERVICE_NAME / SERVICE_TITLE / POSTGRES_DB。
TEMPLATE_NAME=embedding-service
SERVICE_NAME=embedding-service
SERVICE_TITLE=Embedding Service
SERVICE_API_PREFIX=/api/v1/ai-jobs

# ── 本地运行形态 / Compose 编排 ────────────────────────────────────────────────
# dev.sh 本地 API 监听地址；免鉴权联调开关打开时必须保持 loopback。
API_HOST=127.0.0.1
# dev.sh 本地 API 端口。
API_PORT=18210
# compose full 模式暴露到宿主机的 API 端口。
API_HOST_PORT=18210
# docker compose 项目名。决定本地容器、网络和 volume 名称前缀；同机多副本运行时应改成不同值。
COMPOSE_PROJECT_NAME=embedding-service
# compose PostgreSQL 初始化 database 名称，应与 DATABASE_URL 的 database name 保持一致。
POSTGRES_DB=embedding_service
# PostgreSQL 映射到宿主机的端口，应与 DATABASE_URL 端口保持一致。
POSTGRES_HOST_PORT=25440
# Redis 映射到宿主机的端口，应与 REDIS_URL 端口保持一致。
REDIS_HOST_PORT=26387
# worker 进程并发数，传给 Taskiq worker。
WORKER_CONCURRENCY=4
# worker 日志等级。
WORKER_LOGLEVEL=INFO

# ── 基础设施凭证 ──────────────────────────────────────────────────────────────
# PostgreSQL 连接串：API、worker 和 Alembic 迁移都会使用。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25440/embedding_service
# 本地 docker compose 不需要 SSL；生产环境改为 true 或移除此行（默认 true）。
DB_SSL=false
# DB 连接池容量（API pod 维度）。worker-bundle 会额外启动 dispatcher/callbacker/reconciler 常驻角色。
#   api_pod 数 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + worker-bundle 总 DB 连接预算 ≤ PG max_connections(100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 服务鉴权 token：调用 /models、/prompt-templates、/jobs 等受保护 API 时放到 Authorization: Bearer。
# 可用 ./scripts/tools.sh secret --prefix prd_ 生成 URL-safe 随机值。
SERVICE_API_KEY=<替换为随机 token>
# 本地联调开关：true 时跳过 Authorization: Bearer 校验；仅允许 loopback API/DB/Redis 地址，生产环境必须保持 false。
DISABLE_HTTP_AUTH_HEADER=false
# 本地联调开关：true 时忽略 X-AI-Service-Caller-ID，并统一使用 default caller_id；仅允许 loopback API/DB/Redis 地址，生产环境必须保持 false。
DISABLE_CALLER_ID_HEADER=false

# Redis 连接串：Taskiq broker 使用。
REDIS_URL=redis://127.0.0.1:26387/0
# TaskIQ broker 行为；redis_stream 需要 Redis 6.2+ 的 XAUTOCLAIM，Redis 5 环境可使用 redis_list。
TASKIQ_BROKER_KIND=redis_stream

# ── API 访问控制 ──────────────────────────────────────────────────────────────
# CORS 允许来源；多个来源用逗号分隔。
ALLOWED_ORIGINS=http://localhost:3000
# Callback 签名密钥：服务回调业务后端时生成 X-AI-Service-Signature。
CALLBACK_SIGNING_SECRET=<替换为随机 32 字节 hex>
# 是否允许 http://127.0.0.1 或 http://localhost callback；本地联调可为 true，非本地环境应关闭。
ALLOW_INSECURE_CALLBACKS=true

# ── 对象存储（可选）────────────────────────────────────────────────────────────
# 当前接口服务默认不需要对象存储配置；仅在后续启用对象存储输入/输出时按需打开。
# local 只适用于本地开发或单机 compose；生产/多副本 API + worker 必须使用外部对象存储后端。
STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_PATH=storage/objects
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PROJECT_ROOT=
OSS_OUTPUT_PREFIX=ai-jobs
# OSS API endpoint 高级覆盖；通常留空，由 OSS_REGION 派生为 oss-<region>.aliyuncs.com；只有服务端读写也必须走自定义域名/代理时才填写。
OSS_ENDPOINT=
# 返回给调用方的 public_url endpoint；可填写当前 bucket/project 专用 CDN 域名，例如 aigc-datas.epubgame.com。
OSS_PUBLIC_ENDPOINT=

# ── AI 执行 ───────────────────────────────────────────────────────────────────
# OpenAI API Key：真实模型调用必填；不要提交真实密钥。
OPENAI_API_KEY=
# OpenAI 兼容网关地址：为空表示使用默认 OpenAI endpoint；私有网关/代理时填写。
OPENAI_BASE_URL=
# DashScope API Key：接入通义千问文本、图片或向量模型时填写；不要提交真实密钥。
DASHSCOPE_API_KEY=
# DashScope OpenAI-compatible base URL；用于 compatible /models 与兼容调用。
# 多模态向量等 DashScope 原生 API 使用同一个 host，由代码内部推导 /api/v1 后再拼具体接口路径。
# 不要把 /api/v1/services/embeddings/... 这类完整接口路径填到这里。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 当前服务实例启用的外部 root job_type；为空表示启用全部静态注册 job_type，显式配置时多个值用逗号分隔。
ENABLED_JOB_TYPES=
# tagged_text_translation 单 Job item 数量上限；默认允许批量提交最多 100 个 item，缺省时使用代码默认值。
TAGGED_TEXT_TRANSLATION_MAX_ITEMS=100
# tagged_text_translation 单 item 原始 text 字符数上限；按 Unicode code point 计数，包含标签、占位符、标点和空白。
TAGGED_TEXT_TRANSLATION_MAX_TEXT_LENGTH=200
# tagged_text_translation 单 Job 所有 items[].text 原始字符数总上限；按 Unicode code point 计数。
TAGGED_TEXT_TRANSLATION_MAX_TOTAL_TEXT_LENGTH=20000
# poster_title_image 单 Job item 数量上限；默认允许批量提交最多 50 个 item。
POSTER_TITLE_IMAGE_MAX_ITEMS=50
# poster_title_image 单 item 候选图数量上限；只能在接口硬上限 1..4 内收紧，不能放大。
POSTER_TITLE_IMAGE_MAX_DRAW_COUNT=4
# audio_stem_separation ONNX Runtime 执行 provider：auto 有 CUDA 用 CUDA 否则 CPU；cpu 强制 CPU；cuda 强制 CUDA，不可用时失败。
AUDIO_STEM_SEPARATION_EXECUTION_PROVIDER=cpu
# htdemucs-ft ONNX required 模型文件目录；本地默认由 scripts/models.sh 下载到该路径。
HTDEMUCS_MODEL_DIR=.data/models/htdemucs-ft
# audio_stem_separation_triton 的 Triton HTTP endpoint；tritonclient 要求不带 http:// 或 https://。
AUDIO_STEM_TRITON_URL=
# audio_stem_separation_triton 的 EAS/Triton 调用 Token；本地无鉴权 Triton 可留空。
AUDIO_STEM_TRITON_TOKEN=
# Triton model repository 中加载的模型版本目录；默认调用 1/。
AUDIO_STEM_TRITON_MODEL_VERSION=1
# 单次 Triton infer HTTP 请求超时秒数。
AUDIO_STEM_TRITON_REQUEST_TIMEOUT_SECONDS=300
# 模型配置 YAML：定义全局模型启停、默认模型、capability route 和 GET /models 公开投影。
MODEL_CONFIG_PATH=app/ai/catalog/models.yaml
# 价格配置 YAML：enabled 模型必须能通过 pricing_ref 找到合法成本估算规则。
PRICING_CONFIG_PATH=app/ai/pricing/pricing.yaml
# 公共 billing 查询开关；关闭后真实 LLM 调用仍必须经 AI gateway 落账。
BILLING_ENABLED=true
# 是否在模型目录公开 billing capability 摘要；首版默认不扩大 /models 响应。
MODEL_CATALOG_EXPOSE_BILLING_CAPABILITY=false
# 可选 internal Job dashboard；默认关闭。开启后通过 /internal/jobs-dashboard 访问。
OPS_DASHBOARD_ENABLED=false
# Dashboard 会展示完整 Job 输入/输出 JSON；默认要求 Bearer 鉴权，本地隔离排查时才显式改为 false。
OPS_DASHBOARD_REQUIRE_AUTH=true
OPS_DASHBOARD_REFRESH_SECONDS=15
OPS_DASHBOARD_MAX_WINDOW_SECONDS=604800
OPS_DASHBOARD_QUERY_TIMEOUT_SECONDS=2
# AI 调用超时（L1 锚点）：asyncio.wait_for 硬截断 AI 调用；超时后 job → failed(JOB_TIMEOUT) + 发 Callback。
# 代码自动派生 worker 超时链和 recovery 扫描阈值，无需手动配置。
# 调整参考：短文本（< 5000 字）可设 300；中长文本（< 20000 字）建议 600；超长文本可调到 1200。
MODEL_CALL_TIMEOUT_SECONDS=600

# ── Job 容量 & 吞吐量 ─────────────────────────────────────────────────────────
# queued+running 总积压上限，超出返回 503；0 = 禁用检查（内部系统或有外部限速时使用）。
MAX_ACTIVE_JOBS=5000
# 对象存储输入最大字节数；仅启用对象存储输入时需要。
OSS_INPUT_MAX_BYTES=5242880

# ── Callback 可靠性 ───────────────────────────────────────────────────────────
# Callback 单次 HTTP 请求超时，单位秒。
CALLBACK_TIMEOUT_SECONDS=5

# ── Prompt 配置 ──────────────────────────────────────────────────────────────
PROMPT_CONFIG_PATH=app/core/prompts.yaml

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
