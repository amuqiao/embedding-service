# ══════════════════════════════════════════════════════════════════════════════
# CMS Story Tagger 配置模板
#
# 配置面设计原则：只暴露业务可理解的控制意图变量；派生值由代码自动计算；
# 启动时强制校验约束。所有内部缓冲区、批大小、Celery 内部参数均为代码默认值，
# 生产如需调整可直接设置对应环境变量（字段名见 app/core/config.py）。
# ══════════════════════════════════════════════════════════════════════════════

# ── 服务身份 ──────────────────────────────────────────────────────────────────
SERVICE_NAME=cms-story-tagger
SERVICE_TITLE=CMS Story Tagger
SERVICE_API_PREFIX=/api/v1/ai-jobs
# 本地宿主机 API 端口；dev.sh 读取 API_PORT，compose-full 的宿主机映射读取 API_HOST_PORT。
API_PORT=8100
API_HOST_PORT=8100

# ── 基础设施凭证 ──────────────────────────────────────────────────────────────
# 本地 docker compose PostgreSQL 宿主机端口和初始化数据库名。
POSTGRES_HOST_PORT=25432
POSTGRES_DB=cms_story_tagger
# PostgreSQL 连接串：API、worker 和 Alembic 迁移都会使用。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25432/cms_story_tagger
# 本地 docker compose 不需要 SSL；生产环境改为 true 或移除此行（默认 true）。
DB_SSL=false
# DB 连接池容量（API pod 维度）：
#   api_pod 数 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + worker_pod 数 × WORKER_CONCURRENCY ≤ PG max_connections(100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 服务鉴权 token：调用 /models、/prompt-templates、/jobs 等受保护 API 时放到 Authorization: Bearer。
SERVICE_API_KEY=<替换为随机 token>

# 本地 docker compose Redis 宿主机端口。
REDIS_HOST_PORT=26379
# Redis 连接串：Celery broker / result backend 使用。
REDIS_URL=redis://127.0.0.1:26379/0

# ── API 访问控制 ──────────────────────────────────────────────────────────────
# CORS 允许来源；多个来源用逗号分隔。
ALLOWED_ORIGINS=http://localhost:3000
# 本地联调 mock 接口开关；上线后设为 false，避免暴露 mock tool。
ENABLE_MOCK_INTERFACES=true
# Callback 签名密钥：服务回调业务后端时生成 X-AI-Service-Signature。
CALLBACK_SIGNING_SECRET=<替换为随机 32 字节 hex>
# 是否允许 http://127.0.0.1 或 http://localhost callback；本地联调可为 true，非本地环境应关闭。
ALLOW_INSECURE_CALLBACKS=true

# ── 对象存储（可选）────────────────────────────────────────────────────────────
# 当前接口服务默认不需要对象存储配置；仅在后续启用对象存储输入/输出时按需打开。
# STORAGE_BACKEND=local
# LOCAL_OBJECT_STORAGE_PATH=storage/objects
# OSS_BUCKET=
# OSS_REGION=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PROJECT_ROOT=
# OSS_OUTPUT_PREFIX=story-tagger-jobs
# OSS_ENDPOINT=
# OSS_PUBLIC_ENDPOINT=

# ── AI 执行 ───────────────────────────────────────────────────────────────────
# OpenAI API Key：真实模型调用必填；不要提交真实密钥。
OPENAI_API_KEY=
# OpenAI 兼容网关地址：为空表示使用默认 OpenAI endpoint；私有网关/代理时填写。
OPENAI_BASE_URL=
# 默认模型 ID：必须出现在 GET /models 返回的 enabled 模型中。
DEFAULT_MODEL_ID=gpt-5.5
# 模型配置 YAML：定义 /models 返回列表、LiteLLM model id、上下文窗口和调用参数。
MODEL_CONFIG_PATH=app/core/models.yaml
# AI 调用超时（L1 锚点）：asyncio.wait_for 硬截断 AI 调用；超时后 job → failed(JOB_TIMEOUT) + 发 Callback。
# 代码自动派生 Celery soft/hard time_limit 和 recovery 扫描阈值，无需手动配置。
# 调整参考：短文本（< 5000 字）可设 300；中长文本（< 20000 字）建议 600；超长文本可调到 1200。
MODEL_CALL_TIMEOUT_SECONDS=600

# ── 短剧打标 RS 对接 ──────────────────────────────────────────────────────────
# 本地开发默认使用仓库内 JSON fixture，不真实请求 RS；正式环境将两项改为 http。
SHORT_DRAMA_RS_SCHEMA_SOURCE=fixture
SHORT_DRAMA_RS_RESULT_SINK=fixture
# 正式环境 RS base URL 和服务鉴权 token；fixture 模式可留空。
SHORT_DRAMA_RS_BASE_URL=
SHORT_DRAMA_RS_API_KEY=
SHORT_DRAMA_RS_TIMEOUT_SECONDS=10
# fixture 模式使用的本地模拟数据，统一放在 docs/接口层/mock-data/short_drama_tagging/，便于上线后清理。
# 路径中的 {lang} 会替换为 CPP 传入的 subtitle_language；缺少对应文件时直接失败。
SHORT_DRAMA_RS_SCHEMA_FIXTURE_PATH=docs/接口层/mock-data/short_drama_tagging/tag_schema_snapshot.{lang}.json
SHORT_DRAMA_RS_RESULT_RESPONSE_FIXTURE_PATH=docs/接口层/mock-data/short_drama_tagging/rs_write_result_response.success.json

# ── Job 容量 & 吞吐量 ─────────────────────────────────────────────────────────
# queued+running 总积压上限，超出返回 503；0 = 禁用检查（内部系统或有外部限速时使用）。
MAX_ACTIVE_JOBS=5000
# 对象存储输入最大字节数；仅启用对象存储输入时需要。
# OSS_INPUT_MAX_BYTES=5242880
# Worker 并发线程数（由 start-worker.sh 读取）；建议与期望同时运行的 Job 数一致。
WORKER_CONCURRENCY=4

# ── Callback 可靠性 ───────────────────────────────────────────────────────────
# Callback 单次 HTTP 请求超时，单位秒。
CALLBACK_TIMEOUT_SECONDS=5
# Callback 最大投递尝试次数；终态后立即尝试 1 次，失败后由 worker recovery loop 补偿。
CALLBACK_MAX_DELIVERY_ATTEMPTS=12
# Callback 补偿重试间隔，单位秒。
# 约束：必须大于代码派生的内部领取窗口；违反时启动报错。
CALLBACK_RETRY_DELAY_SECONDS=300

# ── Job 重试策略（按需调整，默认不重试）─────────────────────────────────────────
# Celery 任务最大重试次数；0 = 不自动重试（推荐默认值，避免重复消耗 AI 额度）。
# 如果需要任务级别的错误恢复，可在此设置大于 0 的值。
CELERY_MAX_RETRIES=0
# Celery 重试间隔，单位秒；仅 CELERY_MAX_RETRIES > 0 时有意义。
CELERY_RETRY_DELAY=60
# queued+celery_task_id=NULL 超过此秒视为孤儿，恢复扫描重新投递。
JOB_ORPHAN_TIMEOUT_SECONDS=300

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Worker 启动参数（由 start-worker.sh 读取，不影响 API 服务）────────────────
# Pool 模式：solo = 单任务串行（默认）；threads = 多线程并发。
# WORKER_POOL=solo
# Worker 日志级别：debug / info / warning / error。
WORKER_LOGLEVEL=info
