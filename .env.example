# Required
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:15432/novel_localize
SERVICE_API_KEY=dev-service-key

# Infrastructure
REDIS_URL=redis://127.0.0.1:16379/0
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_PATH=storage/objects

# Callback
CALLBACK_SIGNING_SECRET=dev-callback-secret
ALLOW_INSECURE_CALLBACKS=true
CALLBACK_TIMEOUT_SECONDS=5

# AI models
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL_ID=mock-novel-localizer
ENABLE_MOCK_MODEL=true

# Runtime limits
TEXT_INPUT_MAX_BYTES=1048576
OSS_INPUT_MAX_BYTES=5242880
JOB_QUEUE_TIMEOUT_SECONDS=600
JOB_EXECUTION_TIMEOUT_SECONDS=1800
CELERY_SOFT_TIME_LIMIT=1800
CELERY_TIME_LIMIT=1860
CELERY_MAX_RETRIES=0
CELERY_RETRY_DELAY=60
CELERY_RESULT_EXPIRES=86400
NOVEL_LOCALIZATION_P1_MAX_CHARS=5000
NOVEL_LOCALIZATION_CHUNK_SIZE=4500
