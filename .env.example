# 必填配置：数据库连接串和调用本服务 API 时使用的 Bearer Token。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:15432/novel_localize
SERVICE_API_KEY=dev-service-key

# 基础设施：本地 Redis、允许跨域来源、对象存储后端和本地对象存储目录。
# STORAGE_BACKEND 可选 local 或 aliyun_oss；本地默认使用 local。
REDIS_URL=redis://127.0.0.1:16379/0
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_PATH=storage/objects

# 阿里云 OSS：开发环境真实凭据只写入本地 .env，不要提交。
# OSS_ENDPOINT 默认可不填，脚本会按 OSS_REGION 推导为 oss-${OSS_REGION}.aliyuncs.com。
# OSS_ENDPOINT_STYLE 可选 virtual_host、custom_domain、path；使用 OSS_PUBLIC_ENDPOINT 时默认 custom_domain。
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PROJECT_ROOT=
OSS_PUBLIC_ENDPOINT=
OSS_ENDPOINT=
OSS_ENDPOINT_STYLE=
OSS_SCHEME=https

# Callback：回调签名密钥、是否允许非 HTTPS 回调，以及回调请求超时时间。
CALLBACK_SIGNING_SECRET=dev-callback-secret
ALLOW_INSECURE_CALLBACKS=true
CALLBACK_TIMEOUT_SECONDS=5

# AI 模型：真实模型调用需要配置 OPENAI_API_KEY；默认使用 mock 模型便于本地验证。
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL_ID=mock-novel-localizer
ENABLE_MOCK_MODEL=true

# 运行限制：输入大小、Job 排队/执行超时、Celery 超时/重试和结果保留时间。
TEXT_INPUT_MAX_BYTES=1048576
OSS_INPUT_MAX_BYTES=5242880
JOB_QUEUE_TIMEOUT_SECONDS=600
JOB_EXECUTION_TIMEOUT_SECONDS=1800
CELERY_SOFT_TIME_LIMIT=1800
CELERY_TIME_LIMIT=1860
CELERY_MAX_RETRIES=0
CELERY_RETRY_DELAY=60
CELERY_RESULT_EXPIRES=86400

# 分块参数：P1 单次处理最大字符数，以及长文本切分块大小。
NOVEL_LOCALIZATION_P1_MAX_CHARS=5000
NOVEL_LOCALIZATION_CHUNK_SIZE=4500

# 日志级别：常用值为 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
