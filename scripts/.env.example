# scripts/.env.example
#
# 仅用于本地脚本和 docker compose 插值的配置模板。
# ./scripts/dev.sh bootstrap 会在缺少 scripts/.env 时从本文件复制一份。
#
# 注意：
# - 这里的变量不会被 app.core.config.Settings 读取。
# - 应用业务配置、密钥、模型参数、数据库连接串写到仓库根目录 .env。
# - 本文件只放端口、compose 项目名、worker 启动参数等“本地运行形态”配置。
# - 如需临时覆盖，可在命令前显式传 env，例如 API_PORT=18101 ./scripts/dev.sh start。

# API 监听地址。dev.sh 本地启动 API 时使用；免鉴权联调开关打开时必须保持 loopback。
API_HOST=127.0.0.1

# API 容器/宿主机访问端口。local 模式下由 uvicorn 使用；端口被占用时可改这里或临时传 API_PORT。
API_PORT=8100

# docker compose full/deps 模式下映射到宿主机的 API 端口。
# 通常保持与 API_PORT 一致；如果只想改 compose 暴露端口，可单独调整。
API_HOST_PORT=8100

# PostgreSQL 映射到宿主机的端口。本地 .env 的 DATABASE_URL 应与此端口保持一致。
POSTGRES_HOST_PORT=25432

# compose 内 PostgreSQL database 名称。复用模板时可随服务身份一起替换。
POSTGRES_DB=fastapi_best_ai_architecture

# Redis 映射到宿主机的端口。本地 .env 的 REDIS_URL 应与此端口保持一致。
REDIS_HOST_PORT=26379

# worker 进程并发数，传给 Taskiq worker。
WORKER_CONCURRENCY=4

# worker 日志等级。
WORKER_LOGLEVEL=INFO

# 是否启动本地 recovery loop。true 会补偿 orphan attempt、stale running attempt 和 callback 投递。
WORKER_RECOVERY_LOOP=true

# docker compose 项目名。决定容器、网络、volume 名称前缀；同机多副本运行时应改成不同值。
COMPOSE_PROJECT_NAME=fastapi-best-ai-architecture

# poster-title-image 真实流程默认参考图 URL Ref。
# 配齐这 4 项后，./scripts/real-flow.sh poster-title-image 会默认使用该 OSS 对象，不再上传 --reference-image。
# 值来自 ./scripts/real-flow.sh oss-upload-image 输出中的 url_ref，不是 signed_url。
POSTER_TITLE_IMAGE_REFERENCE_PUBLIC_URL=
POSTER_TITLE_IMAGE_REFERENCE_INTERNAL_URL=
POSTER_TITLE_IMAGE_REFERENCE_CONTENT_TYPE=
POSTER_TITLE_IMAGE_REFERENCE_SHA256=
